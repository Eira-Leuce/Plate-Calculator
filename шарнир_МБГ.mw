% Программа расчета методом Бубнова-Галёркина для шарнирного закрепления
restart;
with(plots);
a := 6.0;
b := 3.0;
h := 0.12;
q_load := 8000.;
E_mod := 0.345e11;
mu := 0.2;
n1_terms := 5;
n2_terms := 5;
D_flex := E_mod*h^3/(12*(-mu^2 + 1));
W_ansatz := 0;
for i to n1_terms do
    for j to n2_terms do W_ansatz := W_ansatz + Symbol(sprintf("w%d%d", i, j))*sin(i*Pi*x/a)*sin(j*Pi*y/b); end do;
end do;
W_ansatz_func := unapply(W_ansatz, x, y);
L4_W_ansatz_op_expr := diff(W_ansatz, x $ 4) + 2*diff(W_ansatz, x $ 2, y $ 2) + diff(W_ansatz, y $ 4);
Operator_L_W_expr := D_flex*L4_W_ansatz_op_expr;
Residual_expr := Operator_L_W_expr - q_load;
unknown_coeffs_table := table();
syst_eqns_table := table();
print("Формирование системы уравнений...");
idx_coeff := 0;
for k_eq to n1_terms do
    for l_eq to n2_terms do phi_kl := sin(k_eq*Pi*x/a)*sin(l_eq*Pi*y/b); syst_eqns_table[k_eq, l_eq] := int(Residual_expr*phi_kl, x = 0 .. a, y = 0 .. b) = 0; idx_coeff := idx_coeff + 1; unknown_coeffs_table[idx_coeff] := Symbol(sprintf("w%d%d", k_eq, l_eq)); end do;
end do;
print("Система уравнений сформирована. Решение...");
eqns_to_solve := {seq(seq(syst_eqns_table[k_s, l_s], l_s = 1 .. n2_terms), k_s = 1 .. n1_terms)};
vars_to_solve := {seq(unknown_coeffs_table[idx_s], idx_s = 1 .. idx_coeff)};
solution_coeffs_sys := solve(eqns_to_solve, vars_to_solve);
if solution_coeffs_sys = NULL or numelems(solution_coeffs_sys) = 0 then
    print("Предупреждение: Система не решена или решение пустое. Проверьте уравнения и переменные.");
else
    print("Система решена.");
end if;
W_final_expr_solved := subs(solution_coeffs_sys, W_ansatz);
W_func := unapply(W_final_expr_solved, x, y);
Mx_expr_solved := -D_flex*(diff(W_func(x, y), x $ 2) + mu*diff(W_func(x, y), y $ 2));
My_expr_solved := -D_flex*(diff(W_func(x, y), y $ 2) + mu*diff(W_func(x, y), x $ 2));
Mxy_expr_solved := -D_flex*(1 - mu)*diff(W_func(x, y), x, y);
Mx_maple_func := unapply(Mx_expr_solved, x, y);
My_maple_func := unapply(My_expr_solved, x, y);
Mxy_maple_func := unapply(Mxy_expr_solved, x, y);
Laplacian_W_expr := diff(W_func(x, y), x $ 2) + diff(W_func(x, y), y $ 2);
Qx_expr_solved := -D_flex*diff(Laplacian_W_expr, x);
Qy_expr_solved := -D_flex*diff(Laplacian_W_expr, y);
Qx_maple_func := unapply(Qx_expr_solved, x, y);
Qy_maple_func := unapply(Qy_expr_solved, x, y);
sigma_x_surf_expr_solved := 6*Mx_expr_solved/h^2;
sigma_y_surf_expr_solved := 6*My_expr_solved/h^2;
tau_xy_surf_expr_solved := 6*Mxy_expr_solved/h^2;
sigma_x_maple_func := unapply(sigma_x_surf_expr_solved, x, y);
sigma_y_maple_func := unapply(sigma_y_surf_expr_solved, x, y);
tau_xy_maple_func := unapply(tau_xy_surf_expr_solved, x, y);
x_center := a/2;
y_center := b/2;
W_center_val := evalf(W_func(x_center, y_center));
Mx_center_val := evalf(Mx_maple_func(x_center, y_center));
My_center_val := evalf(My_maple_func(x_center, y_center));
Mxy_center_val := evalf(Mxy_maple_func(x_center, y_center));
sigma_x_center_val := evalf(sigma_x_maple_func(x_center, y_center));
sigma_y_center_val := evalf(sigma_y_maple_func(x_center, y_center));
tau_xy_center_val := evalf(tau_xy_maple_func(x_center, y_center));
Mxy_corner_00_val := evalf(Mxy_maple_func(0, 0));
tau_xy_corner_00_val := evalf(tau_xy_maple_func(0, 0));
Mx_corner_00_val := evalf(Mx_maple_func(0, 0));
My_corner_00_val := evalf(My_maple_func(0, 0));
Qx_edge_x0_val := evalf(Qx_maple_func(0.00001*a, y_center));
Qy_edge_y0_val := evalf(Qy_maple_func(x_center, 0.00001*b));
num_sample_points_x := 101;
num_sample_points_y := 51;
dx_s := a/(num_sample_points_x - 1);
dy_s := b/(num_sample_points_y - 1);
max_abs_Mx_BG := 0;
max_abs_My_BG := 0;
max_abs_Mxy_BG := 0;
max_abs_Qx_BG := 0;
max_abs_Qy_BG := 0;
max_abs_sigma_x_BG := 0;
max_abs_sigma_y_BG := 0;
max_abs_tau_xy_BG := 0;
print("Численный поиск макс. значений по сетке...");
for i_s from 0 to num_sample_points_x - 1 do
    for j_s from 0 to num_sample_points_y - 1 do curr_x := i_s*dx_s; curr_y := j_s*dy_s; val_Mx := abs(evalf(Mx_maple_func(curr_x, curr_y))); if max_abs_Mx_BG < val_Mx then max_abs_Mx_BG := val_Mx; end if; val_My := abs(evalf(My_maple_func(curr_x, curr_y))); if max_abs_My_BG < val_My then max_abs_My_BG := val_My; end if; val_Mxy := abs(evalf(Mxy_maple_func(curr_x, curr_y))); if max_abs_Mxy_BG < val_Mxy then max_abs_Mxy_BG := val_Mxy; end if; current_Qx_val := abs(evalf(Qx_maple_func(curr_x, curr_y))); current_Qy_val := abs(evalf(Qy_maple_func(curr_x, curr_y))); if curr_x < 0.01*a or 0.99*a < curr_x then if max_abs_Qx_BG < current_Qx_val then max_abs_Qx_BG := current_Qx_val; end if; end if; if curr_y < 0.01*b or 0.99*b < curr_y then if max_abs_Qy_BG < current_Qy_val then max_abs_Qy_BG := current_Qy_val; end if; end if; val_sig_x := abs(evalf(sigma_x_maple_func(curr_x, curr_y))); if max_abs_sigma_x_BG < val_sig_x then max_abs_sigma_x_BG := val_sig_x; end if; val_sig_y := abs(evalf(sigma_y_maple_func(curr_x, curr_y))); if max_abs_sigma_y_BG < val_sig_y then max_abs_sigma_y_BG := val_sig_y; end if; val_tau_xy := abs(evalf(tau_xy_maple_func(curr_x, curr_y))); if max_abs_tau_xy_BG < val_tau_xy then max_abs_tau_xy_BG := val_tau_xy; end if; end do;
end do;
print("Поиск завершен.");
printf("\n# --- Данные для plate_data.py (Метод Бубнова-Галеркина, n1=%d, n2=%d) --- \n", n1_terms, n2_terms);
printf("# --- Шарнирное опирание (HINGED) --- \n");
printf("BUBNOV_GALERKIN_STANDARD_HINGED = { \n");
printf("    'max_displacement': %.4e, # Прогиб в центре (он же максимальный)\n", W_center_val);
printf("    'mx_center': %.4e,        # Mx в центре (часто макс. по модулю для S-S)\n", Mx_center_val);
printf("    'my_center': %.4e,        # My в центре (часто макс. по модулю для S-S)\n", My_center_val);
printf("    'mxy_corner': %.4e,       # Mxy в углу (0,0) (макс. по модулю для S-S)\n", Mxy_corner_00_val);
printf("    'Qx_max': %.4e,           # Макс. |Qx| по сетке (ближе к краю x=0 или x=a)\n", max_abs_Qx_BG);
printf("    'Qy_max': %.4e,           # Макс. |Qy| по сетке (ближе к краю y=0 или y=b)\n", max_abs_Qy_BG);
printf("    'sigma_x_center': %.4e,   # sigma_x в центре\n", sigma_x_center_val);
printf("    'sigma_y_center': %.4e,   # sigma_y в центре\n", sigma_y_center_val);
printf("    'tau_xy_corner': %.4e,    # tau_xy в углу (0,0)\n", tau_xy_corner_00_val);
printf("    # Глобальные максимумы по модулю по сетке (для информации или если нужны именно они):\n");
printf("    # 'mx_max_global_abs': %.4e,\n", max_abs_Mx_BG);
printf("    # 'my_max_global_abs': %.4e,\n", max_abs_My_BG);
printf("    # 'mxy_max_global_abs': %.4e,\n", max_abs_Mxy_BG);
printf("    # 'sigma_x_max_global_abs': %.4e,\n", max_abs_sigma_x_BG);
printf("    # 'sigma_y_max_global_abs': %.4e,\n", max_abs_sigma_y_BG);
printf("    # 'tau_xy_max_global_abs': %.4e,\n", max_abs_tau_xy_BG);
printf("}\n");
printf("\n--- РАСЧЕТ ПРЯМОУГОЛЬНОЙ ПЛИТЫ (Метод Бубнова-Галёркина, n1=%d, n2=%d) ---\n", n1_terms, n2_terms);
printf("--- СВОБОДНОЕ ОПИРАНИЕ ---\n");
printf("--- РЕЗУЛЬТАТЫ РАСЧЕТА ---\n\n");
printf("Максимальный прогиб (в центре плиты x=%.2f, y=%.2f):\n", x_center, y_center);
printf("  W_max = % .4e м (%.4f мм)\n\n", W_center_val, 1000*W_center_val);
printf("Изгибающие моменты (в центре плиты x=%.2f, y=%.2f):\n", x_center, y_center);
printf("  Mx_center = % .4e Н*м/м\n", Mx_center_val);
printf("  My_center = % .4e Н*м/м\n\n", My_center_val);
printf("Крутящий момент Mxy:\n");
printf("  Mxy_center (в центре) = % .4e Н*м/м\n", Mxy_center_val);
printf("  Mxy_corner (в углу 0,0) = % .4e Н*м/м\n", Mxy_corner_00_val);
printf("  Mxy_max_abs (макс. по модулю по сетке) = % .4e Н*м/м\n\n", max_abs_Mxy_BG);
printf("Поперечные силы:\n");
printf("  Qx_edge (на середине края x~0, y=%.2f) = % .4e Н/м\n", y_center, Qx_edge_x0_val);
printf("  Qy_edge (на середине края y~0, x=%.2f) = % .4e Н/м\n", x_center, Qy_edge_y0_val);
printf("  Qx_max_abs (макс. |Qx| близко к x-краям) = % .4e Н/м\n", max_abs_Qx_BG);
printf("  Qy_max_abs (макс. |Qy| близко к y-краям) = % .4e Н/м\n\n", max_abs_Qy_BG);
printf("Напряжения на поверхности плиты (z = +/- h/2):\n");
printf("  Нормальное напряжение sigma_x (в центре x=%.2f, y=%.2f):\n", x_center, y_center);
printf("    sigma_x_surf_center = % .4e Па (%.2f МПа)\n", sigma_x_center_val, sigma_x_center_val/0.1e7);
printf("  Нормальное напряжение sigma_y (в центре x=%.2f, y=%.2f):\n", x_center, y_center);
printf("    sigma_y_surf_center = % .4e Па (%.2f МПа)\n", sigma_y_center_val, sigma_y_center_val/0.1e7);
printf("  Касательное напряжение tau_xy:\n");
printf("    tau_xy_surf_center = % .4e Па (%.2f МПа)\n", tau_xy_center_val, tau_xy_center_val/0.1e7);
printf("    tau_xy_surf_corner (в углу 0,0) = % .4e Па (%.2f МПа)\n", tau_xy_corner_00_val, tau_xy_corner_00_val/0.1e7);
printf("    tau_xy_max_abs (макс. по модулю по сетке) = % .4e Па (%.2f МПа)\n\n", max_abs_tau_xy_BG, max_abs_tau_xy_BG/0.1e7);
x_center_for_scaling := a/2;
y_center_for_scaling := b/2;
W_max_for_color_scaling := evalf(W_func(x_center_for_scaling, y_center_for_scaling));
_local(normalized_W_for_color);
if W_max_for_color_scaling <> 0 then
    normalized_W_for_color := W_func(x, y)/W_max_for_color_scaling;
else
    normalized_W_for_color := 0;
end if;
print("Визуализация прогиба плиты (Метод Бубнова-Галёркина):");
P_plot_W := plot3d(W_func(x, y), x = 0 .. a, y = 0 .. b, axes = boxed, labels = ["x, м", "y, м", "Прогиб W, м"], title = "Поверхность прогиба плиты", color = [normalized_W_for_color, 1, 1, colortype = HSV], scaling = constrained);
verthuebar_W := plots:-densityplot(W_func(x, y), y = 0 .. 0.15*b, x = 0 .. 0.1*a, grid = [2, 49], size = [90, 260], colorstyle = HUE, style = surface, axes = frame, labels = [``, ``], axis[1] = [tickmarks = []]);
DocumentTools:-Tabulate([P_plot_W, verthuebar_W], exterior = none, interior = none, weights = [100, 25], widthmode = pixels, width = 500);
print("Визуализация изгибающего момента Mx:");
P_plot_Mx := plot3d(Mx_maple_func(x, y), x = 0 .. a, y = 0 .. b, axes = boxed, labels = ["x, м", "y, м", "Момент Mx, Н*м/м"], title = "Поверхность изгибающего момента Mx", color = [Mx_maple_func(x, y), 1, 1, colortype = HSV]);
verthuebar_Mx := plots:-densityplot(Mx_maple_func(x, y), y = 0 .. 0.15*b, x = 0 .. 0.1*a, grid = [2, 49], size = [90, 260], colorstyle = HUE, style = surface, axes = frame, labels = [``, ``], axis[1] = [tickmarks = []]);
DocumentTools:-Tabulate([P_plot_Mx, verthuebar_Mx], exterior = none, interior = none, weights = [100, 25], widthmode = pixels, width = 500);
print("Визуализация изгибающего момента My:");
P_plot_My := plot3d(My_maple_func(x, y), x = 0 .. a, y = 0 .. b, axes = boxed, labels = ["x, м", "y, м", "Момент My, Н*м/м"], title = "Поверхность изгибающего момента My", color = [My_maple_func(x, y), 1, 1, colortype = HSV]);
verthuebar_My := plots:-densityplot(My_maple_func(x, y), y = 0 .. 0.15*b, x = 0 .. 0.1*a, grid = [2, 49], size = [90, 260], colorstyle = HUE, style = surface, axes = frame, labels = [``, ``], axis[1] = [tickmarks = []]);
DocumentTools:-Tabulate([P_plot_My, verthuebar_My], exterior = none, interior = none, weights = [100, 25], widthmode = pixels, width = 500);
print("Визуализация крутящего момента Mxy:");
P_plot_Mxy := plot3d(Mxy_maple_func(x, y), x = 0 .. a, y = 0 .. b, axes = boxed, labels = ["x, м", "y, м", "Момент Mxy, Н*м/м"], title = "Поверхность крутящего момента Mxy", color = [Mxy_maple_func(x, y), 1, 1, colortype = HSV]);
verthuebar_Mxy := plots:-densityplot(Mxy_maple_func(x, y), y = 0 .. 0.15*b, x = 0 .. 0.1*a, grid = [2, 49], size = [90, 260], colorstyle = HUE, style = surface, axes = frame, labels = [``, ``], axis[1] = [tickmarks = []]);
DocumentTools:-Tabulate([P_plot_Mxy, verthuebar_Mxy], exterior = none, interior = none, weights = [100, 25], widthmode = pixels, width = 500);
print("Визуализация поперечной силы Qx:");
P_plot_Qx := plot3d(Qx_maple_func(x, y), x = 0 .. a, y = 0 .. b, axes = boxed, labels = ["x, м", "y, м", "Сила Qx, Н/м"], title = "Поверхность поперечной силы Qx", color = [Qx_maple_func(x, y), 1, 1, colortype = HSV]);
verthuebar_Qx := plots:-densityplot(Qx_maple_func(x, y), y = 0 .. 0.15*b, x = 0 .. 0.1*a, grid = [2, 49], size = [90, 260], colorstyle = HUE, style = surface, axes = frame, labels = [``, ``], axis[1] = [tickmarks = []]);
DocumentTools:-Tabulate([P_plot_Qx, verthuebar_Qx], exterior = none, interior = none, weights = [100, 25], widthmode = pixels, width = 500);
print("Визуализация поперечной силы Qy:");
P_plot_Qy := plot3d(Qy_maple_func(x, y), x = 0 .. a, y = 0 .. b, axes = boxed, labels = ["x, м", "y, м", "Сила Qy, Н/м"], title = "Поверхность поперечной силы Qy", color = [Qy_maple_func(x, y), 1, 1, colortype = HSV]);
verthuebar_Qy := plots:-densityplot(Qy_maple_func(x, y), y = 0 .. 0.15*b, x = 0 .. 0.1*a, grid = [2, 49], size = [90, 260], colorstyle = HUE, style = surface, axes = frame, labels = [``, ``], axis[1] = [tickmarks = []]);
DocumentTools:-Tabulate([P_plot_Qy, verthuebar_Qy], exterior = none, interior = none, weights = [100, 25], widthmode = pixels, width = 500);
print("Визуализация напряжения sigma_x:");
P_plot_sigma_x := plot3d(sigma_x_maple_func(x, y), x = 0 .. a, y = 0 .. b, axes = boxed, labels = ["x, м", "y, м", "Напряжение sigma_x, Па"], title = "Поверхность напряжения sigma_x", color = [sigma_x_maple_func(x, y), 1, 1, colortype = HSV]);
verthuebar_sigma_x := plots:-densityplot(sigma_x_maple_func(x, y), y = 0 .. 0.15*b, x = 0 .. 0.1*a, grid = [2, 49], size = [90, 260], colorstyle = HUE, style = surface, axes = frame, labels = [``, ``], axis[1] = [tickmarks = []]);
DocumentTools:-Tabulate([P_plot_sigma_x, verthuebar_sigma_x], exterior = none, interior = none, weights = [100, 25], widthmode = pixels, width = 500);
print("Визуализация напряжения sigma_y:");
P_plot_sigma_y := plot3d(sigma_y_maple_func(x, y), x = 0 .. a, y = 0 .. b, axes = boxed, labels = ["x, м", "y, м", "Напряжение sigma_y, Па"], title = "Поверхность напряжения sigma_y", color = [sigma_y_maple_func(x, y), 1, 1, colortype = HSV]);
verthuebar_sigma_y := plots:-densityplot(sigma_y_maple_func(x, y), y = 0 .. 0.15*b, x = 0 .. 0.1*a, grid = [2, 49], size = [90, 260], colorstyle = HUE, style = surface, axes = frame, labels = [``, ``], axis[1] = [tickmarks = []]);
DocumentTools:-Tabulate([P_plot_sigma_y, verthuebar_sigma_y], exterior = none, interior = none, weights = [100, 25], widthmode = pixels, width = 500);
print("Визуализация напряжения tau_xy:");
P_plot_tau_xy := plot3d(tau_xy_maple_func(x, y), x = 0 .. a, y = 0 .. b, axes = boxed, labels = ["x, м", "y, м", "Напряжение tau_xy, Па"], title = "Поверхность напряжения tau_xy", color = [tau_xy_maple_func(x, y), 1, 1, colortype = HSV]);
verthuebar_tau_xy := plots:-densityplot(tau_xy_maple_func(x, y), y = 0 .. 0.15*b, x = 0 .. 0.1*a, grid = [2, 49], size = [90, 260], colorstyle = HUE, style = surface, axes = frame, labels = [``, ``], axis[1] = [tickmarks = []]);
